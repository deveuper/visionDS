# visionDS 配置模板：复制本文件内容到用户配置目录的 .env 后填入真实值。
#   Windows : %APPDATA%\vision-ds\.env    （如 C:\Users\<你>\AppData\Roaming\vision-ds\.env）
#   macOS/..: ~/.config/vision-ds/.env
#   也可用环境变量 VISION_DS_CONFIG_DIR 指定其它目录。
# 本模板不含任何真实 Key；真实 .env 已被 .gitignore 排除，切勿提交。

# 小米 MiMo（按量 sk- / Token Plan tp-；国内 Token Plan 建议同时设 MIMO_API_URL）
# MIMO_API_KEY=
# MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1

# 智谱 GLM
# GLM_API_KEY=

# 火山方舟（豆包视觉）
# ARK_API_KEY=

# 阿里云百炼 Qwen-VL
# DASHSCOPE_API_KEY=

# Moonshot Kimi 视觉
# MOONSHOT_API_KEY=

# OpenAI 或任意 OpenAI 兼容网关/中转
# OPENAI_API_KEY=

# 通用变量（可选）
# VISION_HUB_API_KEY=
# VISION_HUB_BASE_URL=
# VISION_HUB_PROVIDER=
